<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/zfm_background">
    <include layout="@layout/view_toolbar" />
    <ScrollView android:id="@+id/toolsScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="20dp">
            <TextView style="@style/Zfm.Section" android:text="@string/section_diagnostics" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/testRootButton" style="@style/Widget.Zfm.Button.Tonal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="5dp" android:text="@string/btn_test_root" app:icon="@drawable/ic_status_24" app:iconGravity="textStart" android:minHeight="52dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/envReportButton" style="@style/Widget.Zfm.Button.Tonal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="5dp" android:text="@string/btn_env_report" app:icon="@drawable/ic_device_24" app:iconGravity="textStart" android:minHeight="52dp" />
            </LinearLayout>
            <TextView style="@style/Zfm.Section" android:text="@string/section_files" />
            <LinearLayout android:id="@+id/patchSoButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:paddingTop="12dp" android:paddingBottom="12dp">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_package_24" android:contentDescription="@null" app:tint="@color/zfm_primary" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="@string/title_patch_so" android:textAppearance="@style/TextAppearance.Zfm.Body" />
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chevron_right_24" android:contentDescription="@null" app:tint="@color/zfm_muted" />
            </LinearLayout>
            <LinearLayout android:id="@+id/importGadgetButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:paddingTop="12dp" android:paddingBottom="12dp">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_package_24" android:contentDescription="@null" app:tint="@color/zfm_primary" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="@string/btn_import_gadget" android:textAppearance="@style/TextAppearance.Zfm.Body" />
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chevron_right_24" android:contentDescription="@null" app:tint="@color/zfm_muted" />
            </LinearLayout>
            <LinearLayout android:id="@+id/importScriptButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:paddingTop="12dp" android:paddingBottom="12dp">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_code_24" android:contentDescription="@null" app:tint="@color/zfm_primary" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="@string/btn_import_script" android:textAppearance="@style/TextAppearance.Zfm.Body" />
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chevron_right_24" android:contentDescription="@null" app:tint="@color/zfm_muted" />
            </LinearLayout>
            <LinearLayout android:id="@+id/importSubConfigButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:paddingTop="12dp" android:paddingBottom="12dp">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_download_24" android:contentDescription="@null" app:tint="@color/zfm_primary" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="@string/action_import_subconfig" android:textAppearance="@style/TextAppearance.Zfm.Body" />
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chevron_right_24" android:contentDescription="@null" app:tint="@color/zfm_muted" />
            </LinearLayout>
            <TextView style="@style/Zfm.Section" android:text="@string/section_crypto_tools" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/encryptScriptButton" style="@style/Widget.Zfm.Button.Tonal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="5dp" android:text="@string/btn_encrypt_script" app:icon="@drawable/ic_lock_24" app:iconGravity="textStart" android:minHeight="52dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/decryptScriptButton" style="@style/Widget.Zfm.Button.Tonal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="5dp" android:text="@string/btn_decrypt_script" app:icon="@drawable/ic_unlock_24" app:iconGravity="textStart" android:minHeight="52dp" />
            </LinearLayout>
            <TextView style="@style/Zfm.Section" android:text="@string/section_device_files" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/viewConfigButton" style="@style/Widget.Zfm.Button.Tonal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="5dp" android:text="@string/btn_view_config" app:icon="@drawable/ic_log_24" app:iconGravity="textStart" android:minHeight="52dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/listDirButton" style="@style/Widget.Zfm.Button.Tonal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="5dp" android:text="@string/btn_list_dir" app:icon="@drawable/ic_folder_24" app:iconGravity="textStart" android:minHeight="52dp" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="20dp" android:background="@color/zfm_outline_variant" />
            <LinearLayout android:id="@+id/settingsToggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:paddingTop="12dp" android:paddingBottom="12dp">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_tools_24" android:contentDescription="@null" app:tint="@color/zfm_primary" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="@string/section_advanced" android:textAppearance="@style/TextAppearance.Zfm.Body" />
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chevron_right_24" android:contentDescription="@null" app:tint="@color/zfm_muted" />
            </LinearLayout>
            <LinearLayout android:id="@+id/advancedTools" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/tools_module_dir">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/moduleDirInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri|textMultiLine" android:maxLines="2" android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/saveModuleDirButton" style="@style/Widget.Zfm.Button.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:text="@string/save_module_directory" android:minHeight="48dp" />
                <TextView style="@style/Zfm.FieldLabel" android:text="@string/tools_su_mode" />
                <Spinner android:id="@+id/suModeSpinner" style="@style/Widget.Zfm.Spinner" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <LinearLayout android:id="@+id/customCommandButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:paddingTop="12dp" android:paddingBottom="12dp">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_terminal_24" android:contentDescription="@null" app:tint="@color/zfm_primary" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="@string/btn_custom_cmd" android:textAppearance="@style/TextAppearance.Zfm.Body" />
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chevron_right_24" android:contentDescription="@null" app:tint="@color/zfm_muted" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/zfm_outline_variant" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@color/zfm_surface" android:paddingStart="12dp" android:paddingEnd="8dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/outputToggle" style="@style/Widget.Zfm.Button.Text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="start|center_vertical" android:text="@string/tools_output" app:icon="@drawable/ic_expand_more_24" app:iconGravity="end" android:minHeight="48dp" />
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/clearOutputButton" style="@style/Widget.Zfm.IconButton" android:src="@drawable/ic_delete_24" android:contentDescription="@string/action_clear" />
    </LinearLayout>
    <ScrollView android:id="@+id/outputScroll" android:layout_width="match_parent" android:layout_height="@dimen/zfm_output_height" android:background="@color/zfm_terminal" android:visibility="gone">
        <TextView android:id="@+id/outputText" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:textIsSelectable="true" android:textColor="@color/zfm_terminal_text" android:textSize="11sp" />
    </ScrollView>
    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
